<%-
%>
---
batch_connect:
  template: vnc
script:
  native:
  - "--ntasks-per-node"
  - "<%= global_num_cores.to_i %>"
  - "--partition"
  <%- if global_enable_debug.to_i == 1 -%>
  - "debug"
  <%- else %>
  - "batch"
  <%- end %>
  <%- if global_enable_mem.to_i == 1 -%>
  - "--mem"
  - "<%= global_mem.to_i%>G"
  <%- end %>
  - "--licenses"
  - "stata@osc:1"
